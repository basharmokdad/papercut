  "beats": [
    {"say": "April thirteenth, 1970. Two hundred thousand miles from Earth.", "kind": "scene", "bg": "night", "moon": [0.5, 0.47, 560], "letters": "1970", "letters_on": "1970", "headline": ["200,000 MILES", "FROM EARTH"], "headline_on": ["Two", "from"], "letters_kicker": "APRIL THIRTEENTH"},
    {"say": "An oxygen tank on Apollo Thirteen explodes.", "kind": "photo", "bg": "rings-red", "photo": "sm", "label": "APOLLO 13", "stamp": "EXPLOSION", "stamp_on": "explodes", "notes": [{"text": "the oxygen tank", "at": [0.33, 0.7], "to": [0.47, 0.55], "on": "tank", "color": "ink"}]},
    {"say": "Jack Swigert radios: Okay, Houston, we've had a problem here.", "kind": "hero", "size": "full", "bg": "press-dark", "band": "night", "hero": "swigert", "label": "JACK SWIGERT", "headline": ["HOUSTON,", "WE'VE HAD", "A PROBLEM"], "cap": false},
    {"say": "The moon landing is off. Now the only goal is getting three men home.", "kind": "kinetic", "bg": "rings-teal", "lines": ["MOON LANDING", "IS OFF.", "GET THREE", "MEN HOME"], "em": ["off.", "home"], "hero": "crew", "cap": false, "hl": ["three"]},
    {"say": "They power down the command module and move into the lunar lander.", "kind": "photo", "bg": "press", "photo": "lm", "label": "AQUARIUS", "notes": [{"text": "their lifeboat", "at": [0.5, 0.735], "to": [0.52, 0.6], "on": "lunar", "color": "red", "size": 76}]},
    {"say": "A lifeboat built for two people, now carrying three.", "kind": "kinetic", "bg": "mustard", "lines": ["A LIFEBOAT", "BUILT FOR TWO,", "NOW CARRYING", "three."], "em": ["three."], "hl": ["two,"], "hero": "lm", "hero_h": 760},
    {"say": "Then the carbon dioxide starts rising.", "kind": "scene", "bg": "press-dark", "letters": "CO2", "letters_at": "mid", "letters_color": "mustard", "letters_on": "carbon", "headline": ["STARTS RISING"], "headline_colors": ["red"], "cap": false, "drop": true},
    {"say": "Engineers on the ground build a fix from plastic bags, cardboard and tape.", "kind": "document", "bg": "grid", "head": "THE FIX", "lines": ["1. PLASTIC BAGS", "2. CARDBOARD", "3. DUCT TAPE"], "mark": 2},
    {"say": "They call it the mailbox. The crew copies it, piece by piece.", "kind": "board", "bg": "newsprint", "center": "mailbox", "around": [{"img": "crew", "tag": "THE CREW"}, {"img": "lm", "tag": "AQUARIUS"}, {"img": "sm", "tag": "DAMAGE"}], "label": "THE MAILBOX", "cap": true},
    {"say": "April seventeenth. Splashdown in the South Pacific.", "kind": "photo", "bg": "sky", "photo": "splash", "label": "17.04.1970", "stamp": "HOME", "stamp_on": "Pacific"},
